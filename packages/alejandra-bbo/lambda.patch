+fn is_hanging_apply(node: &rnix::SyntaxNode) -> bool {
+    if node.kind() != rnix::SyntaxKind::NODE_APPLY {
+        return false;
+    }
+
+    let last = match node.last_child() {
+        Some(last) => last,
+        None => return false,
+    };
+
+    if !matches!(
+        last.kind(),
+        rnix::SyntaxKind::NODE_ATTR_SET
+            | rnix::SyntaxKind::NODE_PAREN
+            | rnix::SyntaxKind::NODE_LIST
+    ) {
+        return false;
+    }
+
+    let head_len: usize =
+        (last.text_range().start() - node.text_range().start()).into();
+    let text = node.text().to_string();
+    let head = &text[..head_len];
+
+    !head.contains('\n') && !head.contains("/*")
+}
